# Supabase (Postgres) — public anon client, used for the `steps` table.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — server-side ONLY, never exposed to the
# browser. Required so the app can read/write the `fitbit_connections`
# table, which stores encrypted OAuth tokens and is intentionally
# unreachable via the anon key (see supabase/migrations/0003_fitbit_connections.sql).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fitbit OAuth2 app credentials (dev.fitbit.com -> create an app, "Server" type).
FITBIT_CLIENT_ID=your-fitbit-client-id
FITBIT_CLIENT_SECRET=your-fitbit-client-secret
# Must exactly match the callback URL registered with your Fitbit app.
FITBIT_REDIRECT_URI=http://localhost:3000/api/fitbit/callback

# Any long random string - used to encrypt stored Fitbit tokens at rest.
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-string

# Optional: protects /api/fitbit/sync from being called by anyone other
# than your Vercel Cron job. See README.md.
CRON_SECRET=replace-with-a-long-random-string
