# Supabase (Postgres) — public anon client, used for Auth (email OTP) and
# reading the `steps` table from the browser where applicable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — server-side ONLY, never exposed to the
# browser. Used by API routes to write `steps` rows and upload screenshots
# to the private `step-screenshots` Storage bucket (see
# supabase/migrations/0006_screenshot_storage.sql), bypassing RLS after the
# route has already verified the caller's identity from their session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Event window (both optional) — the inclusive date range (YYYY-MM-DD) that
# screenshot uploads are validated against and that the leaderboard/profile
# pages display/aggregate over. If unset, both default to the 2026 event's
# dates below. Change these (and redeploy) to reuse the app for a different
# event without a code change. Must be NEXT_PUBLIC_ so the client-side date
# pickers/pills see them too. If set but invalid (bad format, or start after
# end), the app falls back to the defaults and logs a warning.
NEXT_PUBLIC_EVENT_START_DATE=2026-10-13
NEXT_PUBLIC_EVENT_END_DATE=2026-10-19
