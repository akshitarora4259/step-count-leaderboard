# Supabase (Postgres) — public anon client, used for Auth (email OTP) and
# reading the `steps` table from the browser where applicable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase service role key — server-side ONLY, never exposed to the
# browser. Used by API routes to write `steps` rows and upload screenshots
# to the private `step-screenshots` Storage bucket (see
# supabase/migrations/0006_screenshot_storage.sql), bypassing RLS after the
# route has already verified the caller's identity from their session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
